root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

[*.{json,yml,yaml}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true

[src/IPS.MiidleWear.Contracts/**]
# Imported bytes are the compatibility baseline; review changes separately.
trim_trailing_whitespace = false
