<Project>
  <Target Name="WriteArchitectureManifest" AfterTargets="Build" Condition="'$(IsTestProject)' != 'true'">
    <ItemGroup>
      <_ArchitectureLine Include="project=$(MSBuildProjectName)" />
      <_ArchitectureLine Include="@(ProjectReference->'projectReference=%(Filename)')" />
      <_ArchitectureLine Include="@(PackageReference->'packageReference=%(Identity)')" />
      <_ArchitectureLine Include="@(FrameworkReference->'frameworkReference=%(Identity)')" />
    </ItemGroup>
    <WriteLinesToFile File="$(TargetDir)$(MSBuildProjectName).dependencies.txt"
                      Lines="@(_ArchitectureLine)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
