<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Writes docs/openapi/ips-core-receiver.json from the endpoints IPS.MiidleWear.AspNetCore maps (017b), so the package
    and its document cannot disagree. Not shipped and not referenced by src/.
    Run it from the repository root with dotnet run and this project.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <ProjectReference Include="../../src/IPS.MiidleWear.AspNetCore/IPS.MiidleWear.AspNetCore.csproj" />
    <ProjectReference Include="../../src/IPS.MiidleWear.Contracts/IPS.MiidleWear.Contracts.csproj" />
  </ItemGroup>

</Project>
