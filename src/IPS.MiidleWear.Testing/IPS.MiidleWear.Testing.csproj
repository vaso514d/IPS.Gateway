<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Receiver conformance checks a core system runs from its own tests (018): sends what the IPS middleware sends to a
    receiver and reads the answers with the gateway's rules. References Contracts only; no test framework dependency.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>IPS.MiidleWear.Testing</PackageId>
    <Version>3.0.0-preview.1</Version>
    <Description>Conformance checks for a core banking system's IClientPaymentReceiver: sends what the IPS middleware sends and reads the answers with its rules.</Description>
    <PackageTags>IPS;ISO20022;core banking;receiver;testing</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../IPS.MiidleWear.Contracts/IPS.MiidleWear.Contracts.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="IPS.Middleware.IntegrationTests" />
  </ItemGroup>

</Project>
