<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The server side of IPS.MiidleWear.Security for ASP.NET Core (021): the "Server" configuration section (the service's
    URL, the API tokens and the certificates it accepts) and the authentication that endpoints marked
    [RequireIpsAuthentication] require. Used by the gateway and by core systems; references Security and the ASP.NET Core
    shared framework only.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>IPS.MiidleWear.Security.AspNetCore</PackageId>
    <Version>3.0.0-preview.1</Version>
    <Description>ASP.NET Core authentication between a core banking system and the IPS middleware: static API tokens and request signatures, required as configured on the endpoints marked [RequireIpsAuthentication].</Description>
    <PackageTags>IPS;ISO20022;core banking;signature;authentication;ASP.NET Core</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../IPS.MiidleWear.Security/IPS.MiidleWear.Security.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
