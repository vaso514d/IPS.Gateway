        </mxCell>
        <mxCell id="n9" value="შემომავალი processing/reply რიგები შეიცავს journal ID-ებს; გამავალი recovery რიგი — payment ID-ებს. MassTransit / Azure Service Bus არ გამოიყენება." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4f8;strokeColor=#a3b4c7;fontFamily=Sylfaen;fontSize=16;align=left;spacing=16;fontColor=#172b4d;" parent="1" vertex="1">
